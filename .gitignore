# Large generated data
# Note: do NOT ignore the entire data/ directory.
# Raw and processed datasets may need controlled handling.
# Ignore only large generated outputs where appropriate.
data/raw/*
data/processed/*
data/synthetic/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# Generated experiment outputs
experiments/results/*
!experiments/results/.gitkeep

# Generated schemas
contracts/schemas/*
!contracts/schemas/.gitkeep

